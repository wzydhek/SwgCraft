<Window x:Class="SwgCraft.Desktop.ScriptImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fill from SWGEmu Script" Height="620" Width="900" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" Margin="8,8,8,4" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button x:Name="FolderButton" Content="Scripts Folder..." Click="Folder_Click" Padding="10,3" Margin="0,0,24,0"
                    ToolTip="Choose the draft_schematic folder of the SWGEmu scripts"/>
            <Button x:Name="FileButton" Content="Pick Script File..." Click="File_Click" Padding="10,3" Margin="0,0,24,0"
                    ToolTip="Use a different .lua file for this schematic"/>
            <Button x:Name="ApplyButton" Content="Apply" Click="Apply_Click" Padding="16,3" Margin="0,0,6,0" FontWeight="Bold" IsDefault="True"/>
            <Button Content="Cancel" Padding="16,3" IsCancel="True"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="8,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="Apply only fills in what is empty and adds missing slots; differences are listed but nothing already entered is changed. Save the schematics afterwards as usual."/>
        <TextBox x:Name="ReportBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Padding="6" Margin="8,0,8,6"/>
    </DockPanel>
</Window>
