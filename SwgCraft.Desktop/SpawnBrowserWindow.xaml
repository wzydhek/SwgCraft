<Window x:Class="SwgCraft.Desktop.SpawnBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spawn Browser" Height="640" Width="1180">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <CheckBox x:Name="CurrentOnly" Content="Current only" IsChecked="True" VerticalAlignment="Center"
                      Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="2,0,10,0"/>
            <Label Content="Name:"/>
            <TextBox x:Name="NameFilter" Width="110" TextChanged="Filter_Text_Changed"/>
            <Label Content="Type:"/>
            <TextBox x:Name="TypeFilter" Width="140" TextChanged="Filter_Text_Changed"/>
            <Separator/>
            <Button Content="Refresh" Click="Refresh_Click" Padding="8,2"/>
            <Button Content="Import XML file..." Click="Import_Click" Padding="8,2"/>
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusText"/></StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="130"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="SpawnGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F4F4F4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="100"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="170"/>
                    <DataGridTextColumn Header="ER" Binding="{Binding ER}" Width="42"/>
                    <DataGridTextColumn Header="CR" Binding="{Binding CR}" Width="42"/>
                    <DataGridTextColumn Header="CD" Binding="{Binding CD}" Width="42"/>
                    <DataGridTextColumn Header="DR" Binding="{Binding DR}" Width="42"/>
                    <DataGridTextColumn Header="FL" Binding="{Binding FL}" Width="42"/>
                    <DataGridTextColumn Header="HR" Binding="{Binding HR}" Width="42"/>
                    <DataGridTextColumn Header="MB" Binding="{Binding MB}" Width="42"/>
                    <DataGridTextColumn Header="PE" Binding="{Binding PE}" Width="42"/>
                    <DataGridTextColumn Header="OQ" Binding="{Binding OQ}" Width="42"/>
                    <DataGridTextColumn Header="SR" Binding="{Binding SR}" Width="42"/>
                    <DataGridTextColumn Header="UT" Binding="{Binding UT}" Width="42"/>
                    <DataGridTextColumn Header="Spawned" Binding="{Binding Spawned}" Width="120"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
                    <DataGridTextColumn Header="Planets" Binding="{Binding Planets}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
            <DataGrid x:Name="SyncGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sync time" Binding="{Binding Time}" Width="130"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                    <DataGridTextColumn Header="Added" Binding="{Binding Added}" Width="55"/>
                    <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" Width="60"/>
                    <DataGridTextColumn Header="Reopened" Binding="{Binding Reopened}" Width="65"/>
                    <DataGridTextColumn Header="Replaced" Binding="{Binding Replaced}" Width="65"/>
                    <DataGridTextColumn Header="Despawned" Binding="{Binding Despawned}" Width="75"/>
                    <DataGridTextColumn Header="Unmapped" Binding="{Binding Unmapped}" Width="70"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
