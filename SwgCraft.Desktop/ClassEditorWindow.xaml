<Window x:Class="SwgCraft.Desktop.ClassEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Component Classes" Height="640" Width="900" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Add Class" Click="AddClass_Click" Padding="8,2"/>
            <Button Content="Delete Class" Click="DeleteClass_Click" Padding="8,2"/>
            <Separator/>
            <Button Content="Validate" Click="Validate_Click" Padding="8,2"/>
            <Button Content="Save" Click="Save_Click" Padding="8,2" FontWeight="Bold"/>
            <Button Content="Reload" Click="Reload_Click" Padding="8,2"/>
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="CountText"/>
            </StatusBarItem>
            <StatusBarItem><TextBlock x:Name="StatusText"/></StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="130"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="4" TextChanged="FilterBox_TextChanged"
                             ToolTip="Filter classes by name"/>
                    <ListBox x:Name="ClassList" DisplayMemberPath="Name" SelectionChanged="ClassList_SelectionChanged"/>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
                <Grid x:Name="Detail" Grid.Column="2" Margin="6" IsEnabled="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="ID" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                             Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Members" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Add" Click="AddMember_Click" Padding="8,2" Margin="0,0,4,0"/>
                        <Button Content="Delete" Click="DeleteMember_Click" Padding="8,2" Margin="0,0,4,0"/>
                        <Button Content="Move Up" Click="MoveUp_Click" Padding="8,2" Margin="0,0,4,0"/>
                        <Button Content="Move Down" Click="MoveDown_Click" Padding="8,2"/>
                        <TextBlock Text="The first member is the class's base item." Foreground="Gray" Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="MemberGrid" Grid.Row="3" Grid.ColumnSpan="2" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              CanUserReorderColumns="False" SelectionMode="Single" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" ItemsSource="{Binding Members}"/>
                </Grid>
            </Grid>
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
            <ListBox x:Name="IssueList" Grid.Row="2" DisplayMemberPath="Text" FontFamily="Consolas"
                     MouseDoubleClick="IssueList_DoubleClick" ToolTip="Double-click an issue to jump to its class"/>
        </Grid>
    </DockPanel>
</Window>
