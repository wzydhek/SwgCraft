<Window x:Class="SwgCraft.Desktop.HarvestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What to Harvest" Height="780" Width="1400">
    <Window.Resources>
        <SolidColorBrush x:Key="HighBrush" Color="#C8E6C9"/>
        <SolidColorBrush x:Key="TopBrush" Color="#81C784"/>
        <Style x:Key="CapCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Padding" Value="4,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CapTier}" Value="1"><Setter Property="Background" Value="{StaticResource HighBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding CapTier}" Value="2"><Setter Property="Background" Value="{StaticResource TopBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style x:Key="GainCell" TargetType="TextBlock" BasedOn="{StaticResource RightCell}">
            <Setter Property="Foreground" Value="Gray"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Beats}" Value="True">
                    <Setter Property="Foreground" Value="DarkGreen"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Refresh" Click="Refresh_Click" Padding="8,2" FontWeight="Bold"/>
            <Button Content="Summary..." Click="Summary_Click" Padding="8,2"
                    ToolTip="Open the WTH Summary: each best spawn once, with all 11 stats"/>
            <Separator/>
            <CheckBox x:Name="OnlyBetterBox" Content="Only where today's best beats my inventory" VerticalAlignment="Center"
                      Margin="4,0" Click="Option_Click"/>
            <CheckBox x:Name="ShowEmptyBox" Content="Include needs with nothing spawning" VerticalAlignment="Center"
                      Margin="4,0" Click="Option_Click"/>
            <Separator/>
            <Label Content="Search:"/>
            <TextBox x:Name="SearchBox" Width="200" VerticalContentAlignment="Center" TextChanged="Search_Changed"
                     ToolTip="Matches the resource, stats, a schematic that uses it, or the spawn name"/>
        </ToolBar>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="8,4,8,4" Foreground="Gray"
                   Text="One line per resource and stat mix wanted by the schematics of the professions you include in builds (Static Data > Professions). Value is the spawn's weighted stats out of 1000, the number experimentation uses; % of cap compares it with the best that resource type can ever spawn. Gain is how much today's best beats the best stack you hold."/>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right"><TextBlock x:Name="CountText"/></StatusBarItem>
            <StatusBarItem><TextBlock x:Name="StatusText"/></StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="230"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="NeedGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionChanged="NeedGrid_SelectionChanged"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Resource" Width="190" Binding="{Binding Resource}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!-- a specific resource type (not a group such as "Metal (any)") is shown in bold -->
                                    <DataTrigger Binding="{Binding IsSpecific}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Stats" Width="150" Binding="{Binding Stats}"/>
                    <DataGridTextColumn Header="Used by" Width="200" Binding="{Binding UsedBy}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding UsedByAll}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Best spawn" Width="130" Binding="{Binding BestSpawn}" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Type" Width="160" Binding="{Binding BestType}"/>
                    <DataGridTextColumn Header="Planets" Width="170" Binding="{Binding Planets}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Planets}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Value" Width="55" Binding="{Binding Value}" SortMemberPath="ValueSort"
                                        ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="% of cap" Width="62" Binding="{Binding Cap}" SortMemberPath="CapSort"
                                        ElementStyle="{StaticResource CapCell}"/>
                    <DataGridTextColumn Header="Days up" Width="58" Binding="{Binding Days}" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="My best" Width="170" Binding="{Binding MyBest}"/>
                    <DataGridTextColumn Header="Gain" Width="55" Binding="{Binding Gain}" SortMemberPath="GainSort"
                                        ElementStyle="{StaticResource GainCell}"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Header="Wanted by (schematic - experimental - modifier)">
                    <ListBox x:Name="UseList"/>
                </GroupBox>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
                <GroupBox Grid.Column="2" Header="Best current spawns for the selected line">
                    <DataGrid x:Name="CandidateGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Spawn" Width="120" Binding="{Binding Spawn}"/>
                            <DataGridTextColumn Header="Type" Width="150" Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="Stats used" Width="140" Binding="{Binding StatsUsed}"/>
                            <DataGridTextColumn Header="Value" Width="55" Binding="{Binding Value}" SortMemberPath="ValueSort"
                                                ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="% of cap" Width="62" Binding="{Binding Cap}" SortMemberPath="CapSort"
                                                ElementStyle="{StaticResource CapCell}"/>
                            <DataGridTextColumn Header="Days up" Width="58" Binding="{Binding Days}" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Planets" Width="*" Binding="{Binding Planets}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
