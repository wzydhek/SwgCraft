<Window x:Class="SwgCraft.Desktop.AddInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Resource to Inventory" Height="540" Width="1000" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Search name or type:" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox" Width="190" Margin="6,0,14,0" TextChanged="Search_Changed"/>
            <CheckBox x:Name="IncludeDespawned" Content="Include despawned" IsChecked="True" VerticalAlignment="Center"
                      Checked="Despawned_Changed" Unchecked="Despawned_Changed" Margin="0,0,18,0"/>
            <Button Content="New spawn..." Click="NewSpawn_Click" Padding="8,2"
                    ToolTip="Enter a past spawn that is not in the feed data"/>
            <Button Content="Edit..." Click="EditSpawn_Click" Padding="8,2" Margin="6,0,0,0"
                    ToolTip="Edit the selected manual spawn"/>
            <Button Content="Delete" Click="DeleteSpawn_Click" Padding="8,2" Margin="6,0,0,0"
                    ToolTip="Delete the selected manual spawn (not possible while it is in inventory)"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Quantity:" VerticalAlignment="Center"/>
            <TextBox x:Name="QtyBox" Width="80" Margin="6,0,14,0"/>
            <TextBlock Text="Note:" VerticalAlignment="Center"/>
            <TextBox x:Name="NoteBox" Width="220" Margin="6,0,14,0"/>
            <Button Content="Add to Inventory" IsDefault="True" Click="Add_Click" Padding="10,3"/>
            <Button Content="Cancel" IsCancel="True" Padding="10,3" Margin="6,0,0,0"/>
        </StackPanel>
        <DataGrid x:Name="PickGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="100"/>
                <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="170"/>
                <DataGridTextColumn Header="Stats" Binding="{Binding Stats}" Width="*"/>
                <DataGridTextColumn Header="Spawned" Binding="{Binding Spawned}" Width="110"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
