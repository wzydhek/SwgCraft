<Window x:Class="SwgCraft.Desktop.LootItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Looted Items" Height="600" Width="640" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Add" Click="Add_Click" Padding="8,2"/>
            <Button Content="Delete" Click="Delete_Click" Padding="8,2"/>
            <Separator/>
            <Button Content="Validate" Click="Validate_Click" Padding="8,2"/>
            <Button Content="Save" Click="Save_Click" Padding="8,2" FontWeight="Bold"/>
            <Button Content="Reload" Click="Reload_Click" Padding="8,2"/>
        </ToolBar>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="8,6,8,6" Foreground="Gray"
                   Text="Looted components that can be used in schematics through component classes. Serial numbers and stack sizes are tracked in inventory, and modifiers are not tracked at all. The ID is what classes refer to, so don't change it once a class uses it."/>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="CountText"/>
            </StatusBarItem>
            <StatusBarItem><TextBlock x:Name="StatusText"/></StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="120"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="ItemGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserReorderColumns="False"
                      SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="*" SortMemberPath="Name"
                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="ID" Width="240" SortMemberPath="Id"
                                        Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
            <ListBox x:Name="IssueList" Grid.Row="2" DisplayMemberPath="Text" FontFamily="Consolas"
                     MouseDoubleClick="IssueList_DoubleClick" ToolTip="Double-click an issue to jump to its row"/>
        </Grid>
    </DockPanel>
</Window>
