<Window x:Class="SwgCraft.Desktop.ManualSpawnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resource Spawn (manual entry)" Height="640" Width="860" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" IsDefault="True" Click="Save_Click" Padding="16,3"/>
            <Button Content="Cancel" IsCancel="True" Padding="16,3" Margin="6,0,0,0"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Name (one word, as shown in game)"/>
                <TextBox DockPanel.Dock="Top" x:Name="NameBox" Margin="0,2,0,10"/>
                <TextBlock DockPanel.Dock="Top" Text="Resource type (search, then pick a specific type)"/>
                <TextBox DockPanel.Dock="Top" x:Name="TypeSearch" Margin="0,2,0,4" TextChanged="TypeSearch_Changed"/>
                <ListBox x:Name="TypeList" DisplayMemberPath="Display" SelectionChanged="TypeList_SelectionChanged"/>
            </DockPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Stats" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatHint" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,6"/>
                <StackPanel x:Name="StatPanel"/>
                <TextBlock Text="Spawn date (optional)" Margin="0,14,0,0"/>
                <DatePicker x:Name="SpawnedPicker" HorizontalAlignment="Left" Width="160"/>
                <TextBlock Text="Despawn date (optional)" Margin="0,8,0,0"/>
                <DatePicker x:Name="DespawnedPicker" HorizontalAlignment="Left" Width="160"/>
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Foreground="Gray"
                           Text="Leave dates blank if you don't know them. Manual spawns are stored as past spawns and are never changed by feed syncs."/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
